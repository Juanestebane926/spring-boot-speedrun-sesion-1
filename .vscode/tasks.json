{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🎓 Tutor Interactivo (Pistas en Vivo)",
      "type": "shell",
      "command": "python3 tutor.py",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "👀 Tutor en Observación Continua (Reevalúa al guardar)",
      "type": "shell",
      "command": "python3 tutor.py --watch",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Iniciar Servidor Spring Boot",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
